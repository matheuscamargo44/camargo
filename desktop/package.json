{
  "name": "camargo",
  "productName": "camargo",
  "version": "0.17.2",
  "description": "Desktop UI for the camargo League of Legends & VALORANT toolkit",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "vitest run",
    "build:backend": "cd ../backend && uv run pyinstaller --onefile --noconsole --noconfirm --name camargo-backend --distpath dist --workpath build --specpath . --paths . main.py",
    "dist": "npm run build:backend && electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "vitest": "^2.1.9"
  },
  "build": {
    "appId": "com.camargo.app",
    "productName": "camargo",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "backend-manager.js",
      "update-manager.js",
      "src/**/*",
      "!src/**/*.test.js",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/camargo-backend.exe",
        "to": "backend/camargo-backend.exe"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "matheuscamargo44",
        "repo": "camargo"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "camargo-setup-${version}.${ext}",
      "shortcutName": "camargo"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
